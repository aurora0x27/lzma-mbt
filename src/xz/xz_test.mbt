///|
test "decode_liblzma_armthumb_bcj_xz" {
  let src = armthumb_bcj_plain()
  assert_eq(src.length(), 2243)
  assert_eq(
    decode_xz(liblzma_armthumb_xz()[:], 128UL * 1024UL * 1024UL, false),
    src,
  )
}

///|
test "xz_armthumb_bcj_self_roundtrip" {
  let src = armthumb_bcj_plain()
  let enc = encode_xz(src[:], 3, 0, 2, 65536U, check_id=4, bcj_armthumb=true)
  assert_eq(decode_xz(enc[:], 128UL * 1024UL * 1024UL, false), src)
  let arr = copy_bytes(enc)
  assert_eq(arr[13], b'\xC1')
  let at = find_no_props_record(arr, b'\x08')
  assert_true(at >= 0)
  assert_eq(arr[at + 1], b'\x00')
}

///|
test "xz_stream_decoder_armthumb_bcj_block" {
  let src = armthumb_bcj_plain()
  let enc = encode_xz(src[:], 3, 0, 2, 65536U, check_id=4, bcj_armthumb=true)
  let dec = StreamDecoder::new(128UL * 1024UL * 1024UL, false)
  let got : Array[Byte] = []
  let mut i = 0
  while i < enc.length() {
    let (part, _) = dec.feed(enc[i:i + 1])
    for b in part[:] {
      got.push(b)
    }
    i = i + 1
  }
  assert_eq(Bytes::from_array(got[:]), src)
}

///|
test "xz_armthumb_property_size_must_be_zero" {
  let enc = encode_xz(
    armthumb_bcj_plain()[:],
    3,
    0,
    2,
    4096U,
    check_id=1,
    bcj_armthumb=true,
  )
  let arr = copy_bytes(enc)
  let at = find_no_props_record(arr, b'\x08')
  assert_true(at >= 0)
  assert_eq(arr[at + 1], b'\x00')
  arr[at + 1] = b'\x01'
  rewrite_block_header_crc(arr)
  let err = @test.expect_error(() => {
    decode_xz(Bytes::from_array(arr[:])[:], 1024UL * 1024UL, false) |> ignore
  })
  assert_true(err is @coder.Data)
}

///|
test "xz_armthumb_must_not_be_last_filter" {
  let enc = encode_xz(b"tail"[:], 3, 0, 2, 4096U, check_id=1)
  let arr = copy_bytes(enc)
  let lzma2 = find_filter_id(arr, b'\x21')
  assert_true(lzma2 >= 0)
  arr[lzma2] = b'\x08'
  rewrite_block_header_crc(arr)
  let err = @test.expect_error(() => {
    decode_xz(Bytes::from_array(arr[:])[:], 1024UL * 1024UL, false) |> ignore
  })
  assert_true(err is @coder.Data)
}

///|
test "xz_encoder_rejects_armthumb_plus_other_bcj" {
  let err = @test.expect_error(() => {
    encode_xz(
      b"x"[:],
      3,
      0,
      2,
      4096U,
      check_id=1,
      bcj_armthumb=true,
      bcj_arm64=true,
    )
    |> ignore
  })
  assert_true(err is @coder.Data)
}

