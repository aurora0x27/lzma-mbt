///|
test "decode_liblzma_powerpc_bcj_xz" {
  let src = powerpc_bcj_plain()
  assert_eq(src.length(), 2066)
  assert_eq(
    decode_xz(liblzma_powerpc_xz()[:], 128UL * 1024UL * 1024UL, false),
    src,
  )
}

///|
test "xz_powerpc_bcj_self_roundtrip" {
  let src = powerpc_bcj_plain()
  let enc = encode_xz(src[:], 3, 0, 2, 65536U, check_id=4, bcj_powerpc=true)
  assert_eq(decode_xz(enc[:], 128UL * 1024UL * 1024UL, false), src)
  let arr = copy_bytes(enc)
  assert_eq(arr[13], b'\xC1')
  let ppc = find_no_props_record(arr, b'\x05')
  assert_true(ppc >= 0)
  assert_eq(arr[ppc + 1], b'\x00')
}

///|
test "xz_stream_decoder_powerpc_bcj_block" {
  let src = powerpc_bcj_plain()
  let enc = encode_xz(src[:], 3, 0, 2, 65536U, check_id=4, bcj_powerpc=true)
  let dec = StreamDecoder::new(128UL * 1024UL * 1024UL, false)
  let got : Array[Byte] = []
  let mut i = 0
  while i < enc.length() {
    let (part, _) = dec.feed(enc[i:i + 1])
    for b in part[:] {
      got.push(b)
    }
    i = i + 1
  }
  assert_eq(Bytes::from_array(got[:]), src)
}

///|
test "xz_powerpc_property_size_must_be_zero" {
  let enc = encode_xz(
    powerpc_bcj_plain()[:],
    3,
    0,
    2,
    4096U,
    check_id=1,
    bcj_powerpc=true,
  )
  let arr = copy_bytes(enc)
  let ppc = find_no_props_record(arr, b'\x05')
  assert_true(ppc >= 0)
  assert_eq(arr[ppc + 1], b'\x00')
  arr[ppc + 1] = b'\x01'
  rewrite_block_header_crc(arr)
  let err = @test.expect_error(() => {
    decode_xz(Bytes::from_array(arr[:])[:], 1024UL * 1024UL, false) |> ignore
  })
  assert_true(err is @coder.Data)
}

///|
test "xz_powerpc_must_not_be_last_filter" {
  let enc = encode_xz(b"tail"[:], 3, 0, 2, 4096U, check_id=1)
  let arr = copy_bytes(enc)
  let lzma2 = find_filter_id(arr, b'\x21')
  assert_true(lzma2 >= 0)
  arr[lzma2] = b'\x05'
  rewrite_block_header_crc(arr)
  let err = @test.expect_error(() => {
    decode_xz(Bytes::from_array(arr[:])[:], 1024UL * 1024UL, false) |> ignore
  })
  assert_true(err is @coder.Data)
}

///|
test "xz_encoder_rejects_powerpc_plus_other_bcj" {
  let err = @test.expect_error(() => {
    encode_xz(
      b"x"[:],
      3,
      0,
      2,
      4096U,
      check_id=1,
      bcj_powerpc=true,
      bcj_arm=true,
    )
    |> ignore
  })
  assert_true(err is @coder.Data)
}

